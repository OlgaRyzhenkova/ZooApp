<Window x:Class="ZooApp.Views.AnimalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тварина"
        Height="440" Width="440"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F0E8">

    <DockPanel Margin="16">

        <Border DockPanel.Dock="Top" CornerRadius="6"
                Padding="14,10" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#162E0F" Offset="0"/>
                    <GradientStop Color="#3D7A2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🐾" FontSize="20"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Тварина"
                           Foreground="#F5F0E8" FontSize="15"
                           FontWeight="Bold" FontFamily="Georgia"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="✅  Зберегти і закрити"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="170" Margin="0,0,8,0"
                    Click="SaveBtn_Click"/>
            <Button Content="✖  Скасувати і закрити"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="170"
                    Click="CancelBtn_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Вид тварини (наприклад: Лев, Тигр, Дельфін)"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource ValidatedTextBox}"
                         Text="{Binding Species,
                                ValidatesOnDataErrors=True,
                                ValidatesOnExceptions=True,
                                UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Кличка тварини"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource ValidatedTextBox}"
                         Text="{Binding Name,
                                ValidatesOnDataErrors=True,
                                ValidatesOnExceptions=True,
                                UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Країна походження"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource ValidatedTextBox}"
                         Text="{Binding CountryOfOrigin,
                                ValidatesOnDataErrors=True,
                                ValidatesOnExceptions=True,
                                UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Дата народження тварини"
                           Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="BirthDatePicker"
                            Style="{StaticResource ValidatedDatePicker}"
                            Margin="0,0,0,12"
                            SelectedDateChanged="BirthDatePicker_SelectedDateChanged"/>

                <!-- Попередній перегляд -->
                <Border BorderBrush="#B8CFA4" BorderThickness="1"
                        CornerRadius="6" Padding="10"
                        Background="#FAFDF6" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="🔍  Попередній перегляд:"
                                   FontWeight="Bold" FontSize="11"
                                   FontFamily="Segoe UI"
                                   Foreground="#1B3A14" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PreviewText"
                                   Foreground="#4A6A30"
                                   TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>