<Window x:Class="ZooApp.Views.AccountingUnitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Облікова одиниця"
        Height="400" Width="480"
        MinHeight="330" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F0E8">

    <DockPanel Margin="16">

        <Border DockPanel.Dock="Top" CornerRadius="6"
                Padding="14,10" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#162E0F" Offset="0"/>
                    <GradientStop Color="#3D7A2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="WindowTitle" Text="Облікова одиниця"
                       Foreground="#F5F0E8" FontSize="15"
                       FontWeight="Bold" FontFamily="Georgia"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="✅  Зберегти і закрити"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="170" Margin="0,0,8,0"
                    Click="SaveBtn_Click"/>
            <Button Content="✖  Скасувати і закрити"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="170"
                    Click="CancelBtn_Click"/>
        </StackPanel>

        <StackPanel>

            <TextBlock Text="Дата надходження до приміщення"
                       Style="{StaticResource FieldLabel}"/>
            <DatePicker x:Name="ArrivalDatePicker"
                        Style="{StaticResource ValidatedDatePicker}"
                        Margin="0,0,0,12"
                        SelectedDateChanged="ArrivalDatePicker_SelectedDateChanged"/>

            <TextBlock Text="Вартість утримання (грн.)"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource ValidatedTextBox}"
                     Text="{Binding KeepingCost,
                            ValidatesOnDataErrors=True,
                            ValidatesOnExceptions=True,
                            UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,14"/>

            <Border BorderBrush="#B8CFA4" BorderThickness="1"
                    CornerRadius="6" Padding="12" Background="#FAFDF6">
                <StackPanel>
                    <TextBlock Text="🐾  Тварина"
                               FontWeight="Bold" FontSize="13"
                               FontFamily="Georgia"
                               Foreground="#1B3A14" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AnimalDisplayText"
                               Text="(тварину не вказано)"
                               Foreground="#8A6A40"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="✏️  Редагувати дані тварини"
                            Style="{StaticResource EditButton}"
                            HorizontalAlignment="Left"
                            Click="EditAnimalBtn_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </DockPanel>
</Window>