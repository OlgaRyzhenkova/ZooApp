<Window x:Class="ZooApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Зоопарк — Управління приміщеннями"
        Height="680" Width="1000"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E8"
        Closing="Window_Closing">

    <DockPanel>

        <!-- ══ Меню ══════════════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top" Background="#1B3A14"
              Foreground="#E8DFC8" Padding="6,3"
              FontFamily="Segoe UI" FontSize="13">
            <MenuItem Header="Файл" Foreground="#E8DFC8">
                <MenuItem Header="💾  Зберегти"  Click="MenuSave_Click"/>
                <Separator/>
                <MenuItem Header="🚪  Вийти"     Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Довідка" Foreground="#E8DFC8"
                      Click="MenuAbout_Click"/>
        </Menu>

        <!-- ══ Шапка ═════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Padding="20,14,20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#162E0F" Offset="0"/>
                    <GradientStop Color="#2D5A1B" Offset="0.6"/>
                    <GradientStop Color="#3D7A2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🌿" FontSize="28" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ZooNameText"
                                   Text="Зоопарк"
                                   Foreground="#F5F0E8"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   FontFamily="Georgia"/>
                        <TextBlock Text="Управління приміщеннями"
                                   Foreground="#A8C88A"
                                   FontSize="12"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>

                <!-- Статистика у шапці -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#1A3D0F" CornerRadius="6"
                            Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="TotalRoomsText"
                                       Text="0 приміщень"
                                       Foreground="#A8C88A"
                                       FontSize="11" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A3D0F" CornerRadius="6"
                            Padding="12,6" Margin="0,0,8,0">
                        <TextBlock x:Name="TotalAnimalsText"
                                   Text="0 тварин"
                                   Foreground="#A8C88A"
                                   FontSize="11" FontFamily="Segoe UI"/>
                    </Border>
                    <Border Background="#1A3D0F" CornerRadius="6"
                            Padding="12,6">
                        <TextBlock x:Name="TotalCostText"
                                   Text="0 грн."
                                   Foreground="#D4C89A"
                                   FontSize="11" FontFamily="Segoe UI"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Статус-рядок ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="#3A2810"
                BorderBrush="#5A3D18" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock x:Name="SavePathText"
                       FontSize="10" Foreground="#9E8060"
                       FontFamily="Segoe UI" FontStyle="Italic"/>
        </Border>

        <!-- ══ Основний вміст ═════════════════════════════════════════════════ -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Таблиця приміщень -->
            <GroupBox Grid.Row="0" Header="🏠  Приміщення зоопарку">
                <DataGrid x:Name="RoomsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MinHeight="200"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#D8EDCC"
                          BorderBrush="#B8CFA4"
                          BorderThickness="1"
                          Background="White"
                          AlternatingRowBackground="#F5FAF0"
                          RowHeight="36"
                          FontSize="13"
                          FontFamily="Segoe UI"
                          Foreground="#2C1F0E"
                          SelectionChanged="RoomsGrid_SelectionChanged"
                          MouseDoubleClick="RoomsGrid_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D5A1B"/>
                            <Setter Property="Foreground" Value="#E8DFC8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Padding"    Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#1B3A14"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип приміщення"
                            Binding="{Binding DisplayType}" Width="160"/>
                        <DataGridTextColumn Header="Номер"
                            Binding="{Binding Number}" Width="80"/>
                        <DataGridTextColumn Header="Площа (м²)"
                            Binding="{Binding Size}" Width="100"/>
                        <DataGridTextColumn Header="Прибирання (грн.)"
                            Binding="{Binding CleaningCost,
                                      StringFormat={}{0} грн.}" Width="140"/>
                        <DataGridTextColumn Header="Тварин"
                            Binding="{Binding Animals.Count}" Width="80"/>
                        <DataGridTextColumn Header="Вартість утримання (грн.)"
                            Binding="{Binding TotalKeepingCost,
                                      StringFormat={}{0} грн.}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="AddRoomBtn"
                        Content="➕  Додати приміщення"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" MinWidth="160"
                        Click="AddRoomBtn_Click"/>
                <Button x:Name="EditRoomBtn"
                        Content="✏️  Редагувати"
                        Style="{StaticResource EditButton}"
                        Margin="0,0,8,0" MinWidth="130"
                        IsEnabled="False"
                        Click="EditRoomBtn_Click"/>
                <Button x:Name="DeleteRoomBtn"
                        Content="🗑  Видалити"
                        Style="{StaticResource DangerButton}"
                        MinWidth="120"
                        IsEnabled="False"
                        Click="DeleteRoomBtn_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>